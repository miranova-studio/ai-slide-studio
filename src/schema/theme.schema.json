{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frame.local/schema/theme.v1.json",
  "title": "FRAME Theme v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "themeVersion",
    "id",
    "name",
    "category",
    "palette",
    "fonts",
    "masterElements",
    "layouts"
  ],
  "properties": {
    "themeVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "main", "accent", "text"],
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "main": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" }
      }
    },
    "palettePreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseMode", "textMode"],
      "properties": {
        "baseMode": { "enum": ["original", "white", "black"] },
        "textMode": { "enum": ["auto", "white", "black"] }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colorOpacity", "imageOpacity"],
      "properties": {
        "colorOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "imageOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "imageSrc": { "type": "string", "pattern": "^data:image/(png|jpeg|webp);base64," }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "body"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "masterElements": {
      "type": "array",
      "items": {
        "oneOf": [{ "$ref": "#/$defs/shape" }, { "$ref": "#/$defs/image" }]
      }
    },
    "layouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "image"],
      "properties": {
        "title": { "$ref": "#/$defs/layout" },
        "body": { "$ref": "#/$defs/layout" },
        "image": { "$ref": "#/$defs/layout" }
      }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 13.333 },
        "y": { "type": "number", "minimum": 0, "maximum": 7.5 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 13.333 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 7.5 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "body", "image"],
      "properties": {
        "eyebrow": { "$ref": "#/$defs/box" },
        "title": { "$ref": "#/$defs/box" },
        "body": { "$ref": "#/$defs/box" },
        "image": { "$ref": "#/$defs/box" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "src", "x", "y", "width", "height", "style"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "image" },
        "src": {
          "type": "string",
          "pattern": "^data:image/(png|jpeg|webp);base64,"
        },
        "alt": { "type": "string" },
        "x": { "type": "number", "minimum": 0, "maximum": 13.333 },
        "y": { "type": "number", "minimum": 0, "maximum": 7.5 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 13.333 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 7.5 },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fit": { "enum": ["cover", "contain"] },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "borderRadius": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "shape", "x", "y", "width", "height", "style"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "shape" },
        "shape": {
          "enum": ["rect", "roundRect", "ellipse", "triangle", "line", "arrow"]
        },
        "x": { "type": "number", "minimum": 0, "maximum": 13.333 },
        "y": { "type": "number", "minimum": 0, "maximum": 7.5 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 13.333 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 7.5 },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fill"],
          "properties": {
            "fill": { "$ref": "#/$defs/color" },
            "stroke": { "$ref": "#/$defs/color" },
            "strokeWidth": { "type": "number", "minimum": 0, "maximum": 20 },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "fillOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "strokeOpacity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
