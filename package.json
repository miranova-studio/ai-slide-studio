{
  "name": "ai-slide-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base /ai-slide-studio/",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "check:schema": "node scripts/check-schema.mjs",
    "sync-palettes": "node scripts/sync-palettes.mjs",
    "check:themes": "node scripts/check-themes.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:colors": "node scripts/check-colors.mjs",
    "format": "prettier --write src docs examples scripts *.json *.md *.ts *.html"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-jp": "^0.4.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
